{
    "name": "capell-app/site-monitor",
    "description": "Availability, certificate expiry, domain expiry, and incident monitoring from your Capell application host.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\SiteMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\SiteMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\SiteMonitor\\Providers\\SiteMonitorServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.71",
        "capell-app/core": "^1.0.66",
        "capell-app/discovery-foundation": "^1.0",
        "capell-app/frontend": "^1.0",
        "filament/filament": "^5.7.6",
        "filament/support": "^5.7.6",
        "laravel/framework": "^12.61.1|^13.12.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/site-monitor"
    }
}
