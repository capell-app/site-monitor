{
    "name": "capell-app/site-monitor",
    "description": "External uptime, certificate, domain, and incident monitoring for Capell sites.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\SiteMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\SiteMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\SiteMonitor\\Providers\\SiteMonitorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev",
        "filament/filament": "^4.0|^5.0",
        "filament/support": "^4.0|^5.0",
        "laravel/framework": "^11.44.2|^12.0|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/site-monitor"
    }
}
