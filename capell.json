{
    "manifest-version": 3,
    "name": "capell-app/site-monitor",
    "slug": "site-monitor",
    "displayName": "Site Monitor",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Checks the web addresses you list for status, slow responses, certificate expiry and domain renewal, with a dashboard and a log of outages.",
    "product": {
        "group": "Capell Operations",
        "tier": "free",
        "bundle": "operations"
    },
    "namespace": "Capell\\SiteMonitor",
    "surfaces": ["admin", "console", "shared"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/discovery-foundation",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/diagnostics",
            "capell-app/email-studio",
            "capell-app/exception-reports",
            "capell-app/seo-suite",
            "capell-app/site-discovery",
            "capell-app/url-manager"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\SiteMonitor\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
