    "capabilities": [],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\SiteMonitor\\Support\\LaravelSiteMonitorHttpClient"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\SiteMonitor\\Actions\\ReadSiteMonitorCertificateAction",
                "Capell\\SiteMonitor\\Actions\\RunSiteMonitorCheckAction",
                "Capell\\SiteMonitor\\Support\\LaravelSiteMonitorHttpClient",
                "Capell\\SiteMonitor\\Support\\RdapDomainExpiryClient",
                "Capell\\SiteMonitor\\Support\\SiteMonitorDeadline"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:SiteMonitorTarget",
                "Create:SiteMonitorTarget",
                "Update:SiteMonitorTarget",
                "Delete:SiteMonitorTarget",
                "View:SiteMonitorIncident",
                "Update:SiteMonitorIncident"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 20,
        "cacheTags": ["site-monitor"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "site-monitor.storage",
            "label": "Site Monitor storage tables are available",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "site-monitor.command",
            "label": "Site Monitor scheduled command is available",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "site-monitor.target-freshness",
            "label": "Enabled monitor targets are being checked recently",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "site-monitor.open-incidents",
            "label": "No Site Monitor incidents are open",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "warning",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "See which addresses are passing, slow or failing, and which certificates and domains are close to expiry, with every outage logged in the admin.",
        "description": "Keep watch on the public addresses of your sites. Choose a page, certificate or domain check for each, set how often it runs and what status counts as a pass, and see the latest result for every target in one list. Repeated failures are logged as incidents that close when the check passes again, and permissions follow each person's assigned sites.",
        "problem": "Operators can miss an outage or an expiring certificate until visitors report it.",
        "outcome": "The Monitor targets list shows which addresses failed, slowed or are near expiry, and outages are logged as incidents.",
        "faq": [
            {
                "question": "Where do the checks run from?",
                "answer": "From your own server, not from an independent monitoring network. They run as background jobs, which your host or developer must have running."
            },
            {
                "question": "Will it email or message me when a site goes down?",
                "answer": "No. Nobody is emailed or messaged. Two failed checks in a row open an incident by default, which is a logged outage listed under Monitor incidents."
            },
            {
                "question": "Who can see the dashboard?",
                "answer": "Only global administrators see the Site monitor dashboard, which counts how many targets are passing, showing a warning or failing."
            },
            {
                "question": "What does it check besides the page itself?",
                "answer": "A certificate check warns 30 days before expiry. A domain check looks the domain up in its public registration record and warns 45 days before renewal, for .com, .org, .co.uk and a few other common endings."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/site-monitor-target-form.png",
                "alt": "Edit form for a monitor target with a name, address, HTTP status check type, five-minute interval and expected status range",
                "caption": "Set how often a target is checked and which responses count as passing."
            }
        ],
        "categories": ["operations", "monitoring", "admin"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
