{
    "manifest-version": 3,
    "name": "capell-app/site-monitor",
    "slug": "site-monitor",
    "displayName": "Site Monitor",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Availability, certificate expiry, domain expiry, and incident monitoring from your Capell application host.",
    "product": {
        "group": "Capell Operations",
        "tier": "free",
        "bundle": "operations"
    },
    "namespace": "Capell\\SiteMonitor",
    "surfaces": ["admin", "console", "shared"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/discovery-foundation",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/diagnostics",
            "capell-app/email-studio",
            "capell-app/exception-reports",
            "capell-app/seo-suite",
            "capell-app/site-discovery",
            "capell-app/url-manager"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\SiteMonitor\\Providers\\SiteMonitorServiceProvider"
        ],
        "admin": ["Capell\\SiteMonitor\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorDashboardPageContribution",
            "pageClass": "Capell\\SiteMonitor\\Filament\\Pages\\SiteMonitorDashboardPage",
            "labelKey": "capell-site-monitor::package.navigation.dashboard"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorTargetResourceContribution",
            "resourceClass": "Capell\\SiteMonitor\\Filament\\Resources\\SiteMonitorTargets\\SiteMonitorTargetResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorIncidentResourceContribution",
            "resourceClass": "Capell\\SiteMonitor\\Filament\\Resources\\SiteMonitorIncidents\\SiteMonitorIncidentResource"
        },
        {
            "type": "model",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorTargetModelContribution",
            "modelClasses": ["Capell\\SiteMonitor\\Models\\SiteMonitorTarget"]
        },
        {
            "type": "model",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorRunModelContribution",
            "modelClasses": ["Capell\\SiteMonitor\\Models\\SiteMonitorRun"]
        },
        {
            "type": "model",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorIncidentModelContribution",
            "modelClasses": ["Capell\\SiteMonitor\\Models\\SiteMonitorIncident"]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorScheduledChecksContribution",
            "command": "capell:site-monitor:run",
            "frequency": "everyMinute"
        },
        {
            "type": "console-command",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorConsoleCommandsContribution",
            "commands": [
                "capell:site-monitor:run",
                "capell:site-monitor:doctor",
                "capell:site-monitor-screenshot-fixture"
            ],
            "commandClasses": [
                "Capell\\SiteMonitor\\Console\\Commands\\RunSiteMonitorCommand",
                "Capell\\SiteMonitor\\Console\\Commands\\SiteMonitorDoctorCommand",
                "Capell\\SiteMonitor\\Console\\Commands\\SeedSiteMonitorScreenshotFixtureCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorHealthContribution",
            "checkClass": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck"
        },
        {
            "type": "migration",
            "class": "Capell\\SiteMonitor\\Manifest\\SiteMonitorMigrationsContribution",
            "migrationFiles": [
                "2026_06_13_000001_create_site_monitor_targets_table",
                "2026_06_13_000002_create_site_monitor_runs_table",
                "2026_06_13_000003_create_site_monitor_incidents_table",
                "2026_10_04_000001_remove_implicit_timestamp_updates_from_site_monitor"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "site_monitor_targets",
            "site_monitor_runs",
            "site_monitor_incidents"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "run": "capell:site-monitor:run",
        "doctor": "capell:site-monitor:doctor",
        "screenshotFixture": "capell:site-monitor-screenshot-fixture"
    },
    "actions": {
        "buildSiteMonitorDashboard": "Capell\\SiteMonitor\\Actions\\BuildSiteMonitorDashboardAction",
        "recordSiteMonitorRun": "Capell\\SiteMonitor\\Actions\\RecordSiteMonitorRunAction",
        "reconcileSiteMonitorIncident": "Capell\\SiteMonitor\\Actions\\ReconcileSiteMonitorIncidentAction",
        "resolveSiteMonitorTargets": "Capell\\SiteMonitor\\Actions\\ResolveSiteMonitorTargetsAction",
        "runDueSiteMonitorChecks": "Capell\\SiteMonitor\\Actions\\RunDueSiteMonitorChecksAction",
        "runSiteMonitorCheck": "Capell\\SiteMonitor\\Actions\\RunSiteMonitorCheckAction"
    },
    "settings": [],
    "permissions": [
        "View:SiteMonitorTarget",
        "Create:SiteMonitorTarget",
        "Update:SiteMonitorTarget",
        "Delete:SiteMonitorTarget",
        "View:SiteMonitorIncident",
        "Update:SiteMonitorIncident"
    ],
    "capabilities": [
        "site-monitor",
        "uptime-monitoring",
        "ssl-expiry-monitoring",
        "domain-expiry-monitoring",
        "expanded-rdap-domain-expiry",
        "dashboard-query-budget",
        "incident-tracking",
        "incident-notification-events",
        "scheduled-checks",
        "operations-admin"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\SiteMonitor\\Support\\LaravelSiteMonitorHttpClient"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\SiteMonitor\\Support\\LaravelSiteMonitorHttpClient",
                "Capell\\SiteMonitor\\Support\\RdapDomainExpiryClient"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:SiteMonitorTarget",
                "Create:SiteMonitorTarget",
                "Update:SiteMonitorTarget",
                "Delete:SiteMonitorTarget",
                "View:SiteMonitorIncident",
                "Update:SiteMonitorIncident"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 20,
        "cacheTags": ["site-monitor"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "site-monitor.storage",
            "label": "Site Monitor storage tables are available",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "site-monitor.command",
            "label": "Site Monitor scheduled command is available",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "site-monitor.target-freshness",
            "label": "Enabled monitor targets are being checked recently",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "site-monitor.open-incidents",
            "label": "No Site Monitor incidents are open",
            "class": "Capell\\SiteMonitor\\Health\\SiteMonitorHealthCheck",
            "severity": "warning",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Availability and expiry checks with incident history in Capell admin.",
        "description": "Site Monitor checks public URLs, SSL certificates, and domain expiry from scheduled jobs outside the public render path, then records runs and incidents for operators inside Capell admin.",
        "screenshots": [
            {
                "path": "docs/screenshots/site-monitor-target-form.png",
                "alt": "Site Monitor target settings in Capell admin",
                "caption": "Configure the target URL, check type, interval and failure threshold."
            }
        ],
        "categories": ["operations", "monitoring", "admin"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
